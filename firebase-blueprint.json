{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile authenticated with Google",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Business": {
      "title": "Business",
      "description": "Tenant business organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "businessType": { "type": "string" },
        "ownerId": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "currency": { "type": "string" },
        "language": { "type": "string" },
        "plan": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Business branch location",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "isMain": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "businessId", "name"]
    },
    "BusinessMember": {
      "title": "BusinessMember",
      "description": "Member association between user and business tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "businessId", "userId", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document"
    },
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Business tenant document"
    },
    "/businesses/{businessId}/branches/{branchId}": {
      "schema": { "$ref": "#/entities/Branch" },
      "description": "Branches of a business"
    },
    "/businesses/{businessId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/BusinessMember" },
      "description": "Members of a business"
    }
  }
}
